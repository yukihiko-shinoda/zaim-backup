{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run invoke lint < /dev/null"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(uv run invoke clean*)",
      "Bash(uv run invoke dist*)",
      "Bash(uv run invoke lint*)",
      "Bash(uv run invoke path*)",
      "Bash(uv run invoke style*)",
      "Bash(uv run invoke test*)",
      "Bash(uv run pytest*)",
      "Edit(tests/**)",
      "Edit(zaimbackup/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(rm:*)"
    ],
    "deny": [
      "Read(./config.yml)",
      "Read(./money.csv)",
      "Read(./.cache_zaim_api/*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "./config.yml",
        "./money.csv",
        "./.cache_zaim_api/*"
      ]
    }
  }
}
